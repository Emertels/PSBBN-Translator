    <TEXTAREA id="textvalue" scrollbar="true" width="380.0" visible="14" x="270" y="100" z="0" fontsize="13" value="4;3;3;5;4;3;4;4;3;3;4;3;3;4;4;3;4;3;3;3;4;4;3;5;3;13;" >
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.01</LINE>
	<LINE>Impossibile avviare il gioco installato sulla</LINE>
	<LINE>"PlayStation BB Unit"</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.02</LINE>
	<LINE>Impossibile connettersi alla rete, impossibile</LINE>
	<LINE>aggiornare</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.03</LINE>
	<LINE>Impossibile sfogliare i contenuti sulla rete</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.04 Viene</LINE>
	<LINE>visualizzato il messaggio "Spazio libero</LINE>
	<LINE>insufficiente" e non è possibile scaricare o</LINE>
	<LINE>installare contenuto o avviare l'applicazione Mail</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ D.05 Ricevo</LINE>
	<LINE>il messaggio "Errore di autenticazione DNAS" o</LINE>
	<LINE>"Impossibile ottenere informazioni sul server"</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.06 Viene</LINE>
	<LINE>visualizzato il messaggio "Autenticazione DNAS</LINE>
	<LINE>fallita"</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ D.07 Non</LINE>
	<LINE>conosco l'indirizzo IP o l'indirizzo DNS utilizzato</LINE>
	<LINE>per la connessione di rete</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.08 "Errore</LINE>
	<LINE>di acquisizione" viene visualizzato per "Indirizzo</LINE>
	<LINE>MAC" in "Impostazioni dispositivo" nel menu delle</LINE>
	<LINE>impostazioni di sistema.</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.09 Non</LINE>
	<LINE>riesco a visualizzare contenuti come album o giochi</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ D.10</LINE>
	<LINE>"PlayStation BB Navigator" risponde lentamente.</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.11 Il</LINE>
	<LINE>dispositivo esterno collegato alla porta USB non</LINE>
	<LINE>viene riconosciuto</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.12 Non</LINE>
	<LINE>riesco a riprodurre il brano selezionato su Music</LINE>
	<LINE>Channel</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ D.13 Non</LINE>
	<LINE>riesco a scaricare la musica su Music Channel</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ D.14 Il</LINE>
	<LINE>numero rimanente di check-out per un brano non viene</LINE>
	<LINE>visualizzato su Music Channel</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.15 I nomi</LINE>
	<LINE>dei brani estratti su Music Channel non vengono</LINE>
	<LINE>registrati su MD (quando si utilizza Net MD)</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ D.16 Non</LINE>
	<LINE>riesco a registrare la musica su Music Channel</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ D.17 Ho</LINE>
	<LINE>effettuato il check-in di un brano su Music Channel,</LINE>
	<LINE>ma il numero rimanente di check-out non aumenta</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ D.18 L'invio</LINE>
	<LINE>e la ricezione di e-mail non riescono</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ D.19 L'invio</LINE>
	<LINE>dell'e-mail non riesce</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ D.20 La data</LINE>
	<LINE>visualizzata nell'elenco delle e-mail ricevute non è</LINE>
	<LINE>corretta</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.21 Il</LINE>
	<LINE>messaggio "Imposta la tua e-mail" viene visualizzato</LINE>
	<LINE>sul canale dello sviluppatore di un gioco, ecc.</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.22 Quando</LINE>
	<LINE>si avvia "PlayStation BB Navigator", viene</LINE>
	<LINE>visualizzato un messaggio che informa che "è stata</LINE>
	<LINE>impostata una data non supportata"</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.23 Il</LINE>
	<LINE>disco "PlayStation BB Navigator" non si avvia</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.24 Un</LINE>
	<LINE>messaggio che informa che "L'unità PlayStation BB</LINE>
	<LINE>non funziona correttamente" viene visualizzato</LINE>
	<LINE>quando si avvia un disco in "PlayStation BB</LINE>
	<LINE>Navigator".</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.25</LINE>
	<LINE>Danneggiamento del disco "PlayStation BB Navigator"</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="55" g="180" b="255" a="1.0"@@ Q.26 Se la</LINE>
	<LINE>situazione non migliora anche dopo aver eseguito</LINE>
	<LINE>l'operazione corrispondente al sintomo,</LINE>
	<LINE>corrispondente a Q.01, o se non si verifica nessuno</LINE>
	<LINE>dei sintomi</LINE>
	<LINE></LINE>
	<LINE></LINE>
	<LINE></LINE>
	<LINE></LINE>
	<LINE></LINE>
	<LINE></LINE>
	<LINE></LINE>
	<LINE></LINE>
	<LINE></LINE>
	<LINE></LINE>
    </TEXTAREA>


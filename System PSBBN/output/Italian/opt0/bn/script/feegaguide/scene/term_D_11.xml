    <TEXTAREA id="textvalue" skipline="1" scrollbar="true" width="346.0" visible="14" x="270" y="200" z="0" fontsize="12"  valign="center">
	<LINE>Effettueremo le procedure di annullamento</LINE>
	<LINE>dell'iscrizione XYZXYZFEEGATOKENXYZUPPERXYZ.</LINE>
	<LINE>Seleziona "Annulla iscrizione a</LINE>
	<LINE>XYZXYZFEEGATOKENXYZUPPERXYZ" nel menu</LINE>
	<LINE>XYZXYZFEEGATOKENXYZUPPERXYZ. Se annulli l'iscrizione</LINE>
	<LINE>a XYZXYZFEEGATOKENXYZUPPERXYZ, non potrai utilizzare</LINE>
	<LINE>contenuti/servizi compatibili con</LINE>
	<LINE>XYZXYZFEEGATOKENXYZUPPERXYZ.</LINE>
	<LINE></LINE>
	<LINE>@@FONT r="246" g="181" b="59" a="1.0""@@【Nota】</LINE>
	<LINE>Se annulli l'iscrizione, i contenuti/servizi che hai</LINE>
	<LINE>acquistato diventeranno non validi anche prima della</LINE>
	<LINE>data di scadenza, e i contenuti/servizi che stai</LINE>
	<LINE>utilizzando nel corso continuativo verranno</LINE>
	<LINE>automaticamente cancellati.</LINE>
    </TEXTAREA>

